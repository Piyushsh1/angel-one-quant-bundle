# ── Barbell auth API ──────────────────────────────────────────────────────
APP_ENV=dev

# Database (DB_HOST is the compose service name inside the network).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=algo_barbell_dev
DB_USER=algo
DB_PASSWORD=change_me_dev
# Or override the whole DSN (async driver):
# DATABASE_URL=postgresql+psycopg://algo:pw@host:5432/algo_barbell_dev

# Sessions. In prod, SESSION_SECRET MUST be a long random value.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168
SESSION_REMEMBER_DAYS=30

# CORS: the frontend origin(s), comma-separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# Rate limits.
LOGIN_RATE_LIMIT=10/minute
SIGNUP_RATE_LIMIT=5/minute
