# ════════════════════════════════════════════════════════════════════════════
#  ALGO-BARBELL — Hedge-Fund Style 40/40/20 Architecture
#  ─────────────────────────────────────────────────────────────────────────
#  HOW TO USE
#    1.  cp .env.example .env
#    2.  Fill in real values for every line below.
#    3.  NEVER commit your real .env to git.  (.gitignore already blocks it.)
#
#  STRATEGY DESIGN
#    Macro      40%  →  Donchian(10) + RSI(14) breakout on broad-market ETFs
#    Smallcap   40%  →  Minervini VCP volume-breakout on Nifty Smallcap 250
#    Options    20%  →  Intraday momentum on weekly Nifty/BankNifty options
#
#  CAPITAL FENCE — every silo is HARD-CAPPED at its limit.  All sizing is
#  LOCAL.  Bots IGNORE Angel One's global available cash for risk decisions.
# ════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════
#  ANGEL ONE SMARTAPI CREDENTIALS  (REQUIRED)
#  ─────────────────────────────────────────────────────────────────────────
#  Generate at:  https://smartapi.angelone.in/
#  Required segments on this account:
#    - NSE Cash    (always default)
#    - NSE F&O     (for option_predator.py)         ←  must be activated
#    - MCX         (for SILVERMIC commodity in macro)←  must be activated
# ════════════════════════════════════════════════════════════════════════════

API_KEY=your_smartapi_app_key_here
CLIENT_ID=A12345678
PASSWORD=1234
TOTP_SECRET=YOUR_BASE32_TOTP_SECRET


# ════════════════════════════════════════════════════════════════════════════
#  CAPITAL SILOS  (Total: ₹25,000)
#  ─────────────────────────────────────────────────────────────────────────
#  Each engine is HARD-CAPPED at its silo limit.  Bots compute position
#  sizes against THIS, never against broker availablecash.
# ════════════════════════════════════════════════════════════════════════════

MACRO_MAX_CAPITAL=10000
SMALLCAP_MAX_CAPITAL=10000
OPTIONS_MAX_CAPITAL=5000

# Safety cushion subtracted from every silo before sizing (0.10 = 10% idle)
MARGIN_CUSHION_PCT=0.10


# ════════════════════════════════════════════════════════════════════════════
#  RISK PARAMETERS — per silo
#  ─────────────────────────────────────────────────────────────────────────
#  MACRO_RISK_PCT     0.03   → 3% of MACRO_MAX_CAPITAL per trade   (₹300)
#  SMALLCAP_RISK_PCT  0.015  → 1.5% of SMALLCAP_MAX_CAPITAL/trade  (₹150)
#  OPTIONS_DAILY_LOSS -1500  → kill switch: shut bot if MTM ≤ this
# ════════════════════════════════════════════════════════════════════════════

MACRO_RISK_PCT=0.03
MACRO_ATR_SL_MULT=2.0
MACRO_DONCHIAN_LOOKBACK=10
MACRO_RSI_PERIOD=14
MACRO_RSI_THRESHOLD=55

SMALLCAP_RISK_PCT=0.015
SMALLCAP_ATR_SL_MULT=2.0
SMALLCAP_BB_PERIOD=20
SMALLCAP_BB_STD=2.0
SMALLCAP_VOL_MULT=2.5
SMALLCAP_MIN_TURNOVER=5000000
SMALLCAP_UNIVERSE_SIZE=100   # 100 (top liquid) | 250 (full Smallcap 250)

OPTIONS_DAILY_LOSS=-1500
OPTIONS_BREAKOUT_WINDOW_MINS=15
OPTIONS_HARD_EXIT_TIME=15:05
OPTIONS_PAPER_TRADING=true     # MUST start true.  Flip to false only after 5-day paper test passes.
# OPTIONS_PAPER_MODE=true      # legacy alias, optional (back-compat only)

# ── Options V3 — Regime filter + risk knobs ─────────────────────────────────
#  THE REGIME FILTER is the single most important options knob.  Long-premium
#  ORB is structurally -EV when it trades EVERY day (it pays daily theta on the
#  ~80% of flat/choppy days where the breakout fails).  Trading ONLY wide-range
#  days flips it positive.  Backtest (59d NIFTY 15m, ₹40k silo):
#       OR-width threshold   trades   win%    EV/trade     PF
#         0.55%               19      21.1%    -₹64       0.83   (too loose)
#         0.60%                7      42.9%    +₹361      2.43   ← recommended
#         0.70%                2      50.0%    -₹194      0.44   (sample collapses)
#  0 = disabled (legacy "trade every day", -EV).  Recommended: 0.60.
OPTIONS_MIN_ORB_RANGE_PCT=0.60
OPTIONS_SL_PCT=0.06            # initial stop, -6% of entry premium
OPTIONS_TRAIL_TRIGGER_PCT=0.20 # at +20% the SL hops to break-even and trail arms
OPTIONS_TRAIL_DISTANCE_PCT=0.15# runner trails 15% off the peak once armed
OPTIONS_VOL_MULT=1.3           # breakout needs fut_vol ≥ 1.3 × OR-avg
OPTIONS_MIN_FUTURES_OR_VOL=50  # floor: refuse an underlying if OR avg-vol < 50 (data-artefact guard)
OPTIONS_HTF_BIAS_ENABLED=true  # daily SMA-50 gate: above→CE only, below→PE only
OPTIONS_DEAD_ZONE_START=11:30  # no new entries in the lunch chop window
OPTIONS_DEAD_ZONE_END=13:00
OPTIONS_POST_SL_COOLDOWN_MINS=30  # whipsaw firewall after an SL exit
OPTIONS_ENTRY_COOLDOWN_MINS=15    # cooldown after a deterministic abort

# ── Options — Angel One rate-limit pacing (09-Jun-2026 hardening) ───────────
#  The historical-candle API throttles bursts.  These pace the OR-fetch and the
#  per-minute scan so a multi-index morning never silently drops an underlying.
#  The OR window (09:15-09:30) is a COMPLETED window, so retrying is safe (no
#  look-ahead).  Defaults are conservative and well within the 60s cadence.
OPTIONS_OR_FETCH_PACING_SEC=1.5    # gap between per-index OR computations
OPTIONS_OR_FETCH_RETRY=3           # retries for an empty/throttled OR fetch
OPTIONS_OR_FETCH_BACKOFF_SEC=5.0   # backoff that clears Angel's cooldown
OPTIONS_SCAN_FETCH_PACING_SEC=0.8  # spaces the 2nd+ candle fetch each poll cycle


# ════════════════════════════════════════════════════════════════════════════
#  EXECUTION TUNING  (shared)
# ════════════════════════════════════════════════════════════════════════════

TICK_SIZE=0.05
LIMIT_BUFFER=0.05
API_MAX_RETRIES=3
API_BACKOFF_BASE=2.0
API_PACING_SECONDS=0.8

# NSE 2026 retail-algo cap: max order ops/sec
MAX_OPS=10


# ════════════════════════════════════════════════════════════════════════════
#  DEPLOYMENT ENVIRONMENT
# ════════════════════════════════════════════════════════════════════════════
# dev      → orders simulated (paper), own database. Safe sandbox.
# preprod  → orders simulated (paper) against live data, own database.
#            A full production rehearsal with zero money at risk.
# prod     → REAL orders, REAL money. Requires ALLOW_LIVE_ORDERS=true too.
APP_ENV=dev

# Second gate for real money. Ignored unless APP_ENV=prod.
# Leave false until you have validated preprod for several sessions.
ALLOW_LIVE_ORDERS=false


# ════════════════════════════════════════════════════════════════════════════
#  DATABASE  (single PostgreSQL database per environment)
# ════════════════════════════════════════════════════════════════════════════
# One schema for the whole app; engines are separated by an `engine` column.
# Each environment gets its OWN database so state can never cross over.
# Defaults to algo_barbell_<APP_ENV> when DB_NAME is unset.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=algo_barbell_dev
DB_USER=algo
DB_PASSWORD=change_me

# Optional: set DATABASE_URL to override the parts above entirely.
# DATABASE_URL=postgresql://algo:change_me@localhost:5432/algo_barbell_dev

DB_STATEMENT_TIMEOUT_MS=15000

# Local scratch dir (backtest candle cache + instrument master cache).
# NOT trading state — trading state lives in Postgres.
DATA_DIR=data


# ════════════════════════════════════════════════════════════════════════════
#  OPERATOR / DASHBOARD
# ════════════════════════════════════════════════════════════════════════════

DASHBOARD_PASSWORD=change_me   # Command Center login (Streamlit). CHANGE THIS.


# ════════════════════════════════════════════════════════════════════════════
#  TELEMETRY
# ════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_DIR=logs
