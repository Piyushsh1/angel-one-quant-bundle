{
  "name": "barbell-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.7",
    "clsx": "2.1.1",
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "comments": {
    "overrides": "postcss <8.5.28 carries sourceMappingURL path-traversal advisories. It only runs at build time here, but the tree is pinned so audits stay clean."
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.9",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "8.5.28",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
