# ==============================================================================
#  Barbell frontend — public configuration
# ==============================================================================
#  Everything here is inlined into the CLIENT bundle. Never put a secret in a
#  NEXT_PUBLIC_* variable: API keys, DB credentials and broker secrets belong
#  on the backend only.
# ==============================================================================

# Base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Which environment this build talks to: dev | preprod | prod.
# Drives the persistent PAPER / LIVE mode banner.
NEXT_PUBLIC_APP_ENV=dev
